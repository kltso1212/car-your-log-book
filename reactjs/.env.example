# Local PC / LAN / mobile: NO CHANGE NEEDED.
# Keep localhost here; src/services/api.ts reuses the page's hostname at
# runtime, so http://<any-PC-IP>:3000 on a phone just works.
REACT_APP_API_URL=http://localhost:5000
REACT_APP_API_TIMEOUT_MS=5000
PORT=3000
HOST=0.0.0.0
# --- Cloud / another backend ---
# Option A (separate backend URL, baked at build time):
# REACT_APP_API_URL=https://<backend-cloud-run-url>
# Option B (single-origin, nginx proxies /api to backend): REACT_APP_API_URL=/api

PORT=5000
HOST=0.0.0.0
# SQLite file. Local default ../sqlite.db (repo root, shared across backends);
# in compose set SQLITE_PATH=/data/sqlite.db (shared volume) so the db survives rebuilds.
SQLITE_PATH=../sqlite.db
# Dev/LAN default: any PC/phone works with no IP edits. Cloud: explicit URL(s).
CORS_ORIGIN=*

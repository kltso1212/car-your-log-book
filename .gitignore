# Dependencies
node_modules/

# Python
__pycache__/
*.py[cod]

# SQLite dev databases (created on first run, per backend)
*.db
*.db-wal
*.db-shm
*.db-journal

# Logs
*.log

# Local env overrides (backend .env files are tracked templates; anything
# else named .env — e.g. root .env with real secrets — stays untracked).
.env

# IDE / tooling output
tsconfig-resolved.json
*.csproj.user

# One SQLite file shared by whichever backend runs (see docker-compose.yml).
# Copy to .env and adjust for local / docker / cloud.
SQLITE_PATH=./fuel.db

# Backend port (any one backend listens here).
BACKEND_PORT=5000
CORS_ORIGIN=*

# Frontend (reactjs, CRA). Baked at build time.
# Local/compose: keep localhost; the app reuses the page hostname at runtime
# so phones on the same Wi-Fi need no rebuild.
# Cloud separate backend: REACT_APP_API_URL=https://<backend-url>
# Cloud single-origin (recommended): REACT_APP_API_URL=/api
REACT_APP_API_URL=http://localhost:5000
FRONTEND_PORT=3000

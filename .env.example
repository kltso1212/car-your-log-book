# One SQLite file (sqlite.db) at the repo root, shared by whichever backend runs locally.
# Copy to .env and adjust for local / docker / cloud.
# Local (backend cwd): SQLITE_PATH=../sqlite.db. Docker: /data/sqlite.db (see docker-compose.yml).
SQLITE_PATH=./sqlite.db

# Uploaded images (vehicle avatars / record receipts). Default: "uploads"
# next to the SQLite file (same volume in compose, no change needed).
# UPLOAD_DIR=./uploads

# Backend port (any one backend listens here).
BACKEND_PORT=5000
CORS_ORIGIN=*

# Frontend (reactjs, CRA). Baked at build time.
# Local/compose: keep localhost; the app reuses the page hostname at runtime
# so phones on the same Wi-Fi need no rebuild.
# Cloud separate backend: REACT_APP_API_URL=https://<backend-url>
# Cloud single-origin (recommended): REACT_APP_API_URL=/api
REACT_APP_API_URL=http://localhost:5000
FRONTEND_PORT=3000

# Same names as nodejs/.env. Local/LAN default needs no edits
# (CORS * + HOST 0.0.0.0 + runtime hostname detection in the frontend).
PORT=5000
# SQLite file. Local default ./fuel.db; in compose set SQLITE_PATH=/data/fuel.db
# (shared volume) so the db survives container rebuilds.
SQLITE_PATH=./fuel.db
CORS_ORIGIN=*
# Local dev against existing tables: DDL_AUTO=validate. First-time create: update.
DDL_AUTO=update
# --- Cloud ---
# CORS_ORIGIN=https://<frontend-url>

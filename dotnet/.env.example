# Copy to .env or export in shell.
# Overrides appsettings.json without editing files.
# Example (PowerShell): $env:ConnectionStrings__DefaultConnection="Data Source=/data/sqlite.db"
# SQLite file. Local default ../sqlite.db (repo root, shared across backends);
# in compose set ConnectionStrings__DefaultConnection=Data Source=/data/sqlite.db (shared volume).
ConnectionStrings__DefaultConnection=Data Source=../sqlite.db
# Dev/LAN default: * allows any PC/phone on the network with no IP edits.
# Cloud: CORS_ORIGIN=https://<frontend-url>
CORS_ORIGIN=*
ASPNETCORE_URLS=http://+:5000

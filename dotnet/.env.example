# Copy to .env or export in shell.
# Overrides appsettings.json without editing files.
# Example (PowerShell): $env:ConnectionStrings__DefaultConnection="Data Source=/data/fuel.db"
# SQLite file. Local default fuel.db (next to the dll); in compose set
# ConnectionStrings__DefaultConnection=Data Source=/data/fuel.db (shared volume).
ConnectionStrings__DefaultConnection=Data Source=fuel.db
# Dev/LAN default: * allows any PC/phone on the network with no IP edits.
# Cloud: CORS_ORIGIN=https://<frontend-url>
CORS_ORIGIN=*
ASPNETCORE_URLS=http://+:5000
